# Supabase project settings > API. Browser-visible — anon key only, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings > API. Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project settings > Database > Connection pooling. Server-only.
# Serverless functions exhaust direct connections — use the pooled string, not direct.
DATABASE_URL=

# Upstash Redis (Singapore region) > REST API. Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
